<script>
(function() {
  function addQuoteButton() {
    // Find the email link — more unique than phone
    var emailLink = null;
    var links = document.querySelectorAll('a');
    for (var i = 0; i < links.length; i++) {
      if (links[i].href && links[i].href.indexOf('mailto:') !== -1) {
        emailLink = links[i];
        break;
      }
    }

    if (!emailLink) return;

    // Go up to the container holding phone + email
    var container = emailLink.parentNode;

    var btn = document.createElement('div');
    btn.style.cssText = 'margin-top:4px;text-align:right;';

    var link = document.createElement('a');
    link.href = '/contact-us/';
    link.textContent = 'Get a Quote / Ask for Help';
    link.style.cssText = [
      'background:#c8102e',
      'color:#fff',
      'padding:4px 12px',
      'border-radius:4px',
      'font-size:12px',
      'font-weight:700',
      'text-decoration:none',
      'display:inline-block',
      'white-space:nowrap',
      'font-family:inherit'
    ].join(';');

    btn.appendChild(link);
    container.appendChild(btn);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', addQuoteButton);
  } else {
    addQuoteButton();
  }
})();
</script>
